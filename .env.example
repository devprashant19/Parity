# Google Gemini API key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (confirmed vision-capable Flash model)
GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini Fallback Model (used automatically if primary model is 503/overloaded)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Kill-switch flag to disable live extraction if quota expires (true/false)
LIVE_CHECK_ENABLED=true
